{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gymbuddy://knowledge/schema/template.schema.json",
  "title": "ProgrammeTemplate",
  "description": "PR 15 in-repo programme template. additionalProperties is false. Slots name a pattern and a role; the picker fills them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "goals",
    "trainingAges",
    "daysPerWeek",
    "days",
    "provenanceDefault"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["STRENGTH", "HYPERTROPHY", "ENDURANCE", "GENERAL_FITNESS", "FAT_LOSS"]
      }
    },
    "trainingAges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED"]
      }
    },
    "daysPerWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "slots"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pattern", "role", "priority"],
              "properties": {
                "pattern": { "type": "string", "minLength": 1 },
                "role": {
                  "type": "string",
                  "enum": ["PRIMARY", "SECONDARY", "ACCESSORY", "ISOLATION", "CORE"]
                },
                "priority": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Time clamp cuts highest number first. PRIMARY is never cut."
                }
              }
            }
          }
        }
      }
    },
    "provenanceDefault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "basis", "source", "reviewed"],
      "properties": {
        "confidence": { "type": "string" },
        "basis": { "type": "string" },
        "source": { "type": "string" },
        "reviewed": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["confidence", "basis", "source", "reviewed"],
        "properties": {
          "confidence": { "type": "string" },
          "basis": { "type": "string" },
          "source": { "type": "string" },
          "reviewed": { "type": "string" }
        }
      }
    }
  }
}
