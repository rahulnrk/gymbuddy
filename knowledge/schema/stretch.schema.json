{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gymbuddy://knowledge/schema/stretch.schema.json",
  "title": "Stretch",
  "description": "A stretch is not an exercise. Hold and timing, not load. additionalProperties is false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "id",
    "name",
    "type",
    "targetMuscles",
    "timing",
    "holdSec",
    "repeats",
    "perSide",
    "requiredEquipment",
    "howTo",
    "intensityGuidance",
    "contraindications",
    "provenanceDefault"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["static", "dynamic", "active", "pnf"] },
    "targetMuscles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "timing": { "type": "string", "enum": ["warmup", "post-session", "standalone"] },
    "holdSec": { "type": "integer", "minimum": 0, "maximum": 120 },
    "repeats": { "type": "integer", "minimum": 1, "maximum": 6 },
    "perSide": { "type": "boolean" },
    "requiredEquipment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "howTo": { "type": "string", "minLength": 40 },
    "intensityGuidance": { "type": "string", "minLength": 1 },
    "contraindications": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenanceDefault": { "$ref": "#/$defs/provenance" },
    "provenance": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/provenance" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "basis", "source", "reviewed"],
      "properties": {
        "confidence": { "type": "string", "enum": ["low", "moderate", "high"] },
        "basis": { "type": "string", "enum": ["measured", "consensus", "judgement", "inherited"] },
        "source": { "type": "string", "minLength": 1 },
        "reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  }
}
