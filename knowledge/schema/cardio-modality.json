{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gymbuddy://knowledge/schema/cardio-modality.json",
  "title": "CardioModality",
  "description": "A cardio machine or mode. Not a session. Compose with a protocol. additionalProperties is false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "id",
    "name",
    "requiredEquipment",
    "impact",
    "primaryDemand",
    "skillDemand",
    "setting",
    "suitableProtocolTypes",
    "contraindications",
    "provenanceDefault"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "requiredEquipment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "impact": { "type": "string", "enum": ["low", "moderate", "high"] },
    "primaryDemand": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "skillDemand": { "type": "string", "enum": ["low", "moderate", "high"] },
    "setting": { "type": "string", "enum": ["indoor", "outdoor", "either"] },
    "suitableProtocolTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["recovery", "steady_state", "tempo", "threshold", "intervals", "sprint_intervals"]
      }
    },
    "contraindications": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenanceDefault": { "$ref": "#/$defs/provenance" },
    "provenance": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/provenance" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "basis", "source", "reviewed"],
      "properties": {
        "confidence": { "type": "string", "enum": ["low", "moderate", "high"] },
        "basis": { "type": "string", "enum": ["measured", "consensus", "judgement", "inherited"] },
        "source": { "type": "string", "minLength": 1 },
        "reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  }
}
