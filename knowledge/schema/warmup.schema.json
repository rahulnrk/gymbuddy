{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gymbuddy://knowledge/schema/warmup.schema.json",
  "title": "WarmupDrill",
  "description": "A warm-up drill is not an exercise. Duration and purpose, not load. additionalProperties is false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "id",
    "name",
    "method",
    "targetPatterns",
    "targetMuscles",
    "durationSec",
    "reps",
    "perSide",
    "requiredEquipment",
    "howTo",
    "commonErrors",
    "effortGuidance",
    "contraindications",
    "provenanceDefault"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "enum": ["pulse", "mobility", "activation", "rehearsal"] },
    "targetPatterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "targetMuscles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "durationSec": { "type": "integer", "minimum": 15, "maximum": 300 },
    "reps": { "type": "integer", "minimum": 0 },
    "perSide": { "type": "boolean" },
    "requiredEquipment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "howTo": { "type": "string", "minLength": 40 },
    "commonErrors": { "type": "string", "minLength": 1 },
    "effortGuidance": { "type": "string", "minLength": 1 },
    "contraindications": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenanceDefault": { "$ref": "#/$defs/provenance" },
    "provenance": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/provenance" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "basis", "source", "reviewed"],
      "properties": {
        "confidence": { "type": "string", "enum": ["low", "moderate", "high"] },
        "basis": { "type": "string", "enum": ["measured", "consensus", "judgement", "inherited"] },
        "source": { "type": "string", "minLength": 1 },
        "reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  }
}
