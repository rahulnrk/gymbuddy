{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gymbuddy://knowledge/schema/cardio-protocol.json",
  "title": "CardioProtocol",
  "description": "A cardio session shape. Not a machine. Effort is RPE and the talk test only. additionalProperties is false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "id",
    "name",
    "type",
    "intensity",
    "effortGuidance",
    "typicalSessionMin",
    "suitableGoals",
    "requiresAerobicBase",
    "provenanceDefault"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["recovery", "steady_state", "tempo", "threshold", "intervals", "sprint_intervals"]
    },
    "intensity": { "type": "string", "enum": ["easy", "moderate", "hard"] },
    "effortGuidance": { "type": "string", "minLength": 20 },
    "workSec": { "type": "integer", "minimum": 10, "maximum": 600 },
    "recoverSec": { "type": "integer", "minimum": 10, "maximum": 600 },
    "rounds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "typicalSessionMin": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 5, "maximum": 180 }
    },
    "suitableGoals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["STRENGTH", "HYPERTROPHY", "ENDURANCE", "CARDIO_FITNESS", "FAT_LOSS", "GENERAL_FITNESS"]
      }
    },
    "requiresAerobicBase": { "type": "boolean" },
    "provenanceDefault": { "$ref": "#/$defs/provenance" },
    "provenance": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/provenance" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "basis", "source", "reviewed"],
      "properties": {
        "confidence": { "type": "string", "enum": ["low", "moderate", "high"] },
        "basis": { "type": "string", "enum": ["measured", "consensus", "judgement", "inherited"] },
        "source": { "type": "string", "minLength": 1 },
        "reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  }
}
