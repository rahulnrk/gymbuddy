{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gymbuddy://schemas/v1/safety-concern.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "sessionId",
    "userId",
    "occurredAt",
    "recordedAt",
    "source",
    "schemaVersion",
    "type",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "voice",
        "manual",
        "imported",
        "ai-generated",
        "system"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "transcriptId": {
      "type": "string",
      "format": "uuid"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sttFinalHash": {
      "type": "string",
      "minLength": 8
    },
    "batchId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "SAFETY_CONCERN"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "category",
        "transcriptSnippet",
        "action"
      ],
      "properties": {
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "category": {
          "type": "string"
        },
        "transcriptSnippet": {
          "type": "string"
        },
        "action": {
          "enum": [
            "advise",
            "pause",
            "stop_recommend"
          ]
        }
      }
    }
  }
}
