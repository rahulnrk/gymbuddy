{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gymbuddy://schemas/v1/workout-started.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "sessionId",
    "userId",
    "occurredAt",
    "recordedAt",
    "source",
    "schemaVersion",
    "type",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "voice",
        "manual",
        "imported",
        "ai-generated",
        "system"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "transcriptId": {
      "type": "string",
      "format": "uuid"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sttFinalHash": {
      "type": "string",
      "minLength": 8
    },
    "batchId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "WORKOUT_STARTED"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workoutId",
        "startedAt"
      ],
      "properties": {
        "workoutId": {
          "type": "string",
          "format": "uuid"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
